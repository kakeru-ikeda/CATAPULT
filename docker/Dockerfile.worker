FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
COPY packages/worker/package*.json ./packages/worker/
COPY tsconfig.base.json ./

RUN npm ci --workspace=packages/worker

COPY packages/worker/src ./packages/worker/src
COPY packages/worker/tsconfig.json ./packages/worker/

RUN npm run build --workspace=packages/worker

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# git と GitHub Copilot CLI のインストール
RUN apk add --no-cache git curl

# GitHub Copilot CLI インストール
RUN npm install -g @githubnext/github-copilot-cli || true

COPY package*.json ./
COPY packages/worker/package*.json ./packages/worker/

RUN npm ci --workspace=packages/worker --omit=dev

COPY --from=builder /app/packages/worker/dist ./packages/worker/dist

CMD ["node", "packages/worker/dist/index.js"]
