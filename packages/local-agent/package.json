{
  "name": "catapult-agent",
  "version": "1.0.5",
  "description": "CATAPULT Local Agent - A command-line tool for AI coding assistance",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "catapult-agent": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:commander && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "catapult",
    "copilot-catapult",
    "github-copilot",
    "local-agent",
    "copilot-cli",
    "ai-coding",
    "agent",
    "slack",
    "discord"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kakeru-ikeda/CATAPULT.git",
    "directory": "packages/local-agent"
  },
  "homepage": "https://github.com/kakeru-ikeda/CATAPULT#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@catapult/core": "^1.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.4",
    "typescript": "^5.5.0"
  }
}
