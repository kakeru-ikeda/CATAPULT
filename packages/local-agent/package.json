{
  "name": "catapult-agent",
  "version": "1.0.1",
  "description": "CATAPULT Local Agent - A command-line tool for AI coding assistance",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "catapult-agent": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node -e \"import('fs').then(fs => { const p = './dist/index.js'; const c = fs.readFileSync(p,'utf8'); if(!c.startsWith('#!/')) fs.writeFileSync(p,'#!/usr/bin/env node\\n'+c); require('child_process').execSync('chmod +x '+p); })\"",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "catapult",
    "copilot-catapult",
    "github-copilot",
    "local-agent",
    "copilot-cli",
    "ai-coding",
    "agent",
    "slack",
    "discord"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kakeru-ikeda/CATAPULT.git",
    "directory": "packages/local-agent"
  },
  "homepage": "https://github.com/kakeru-ikeda/CATAPULT#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@catapult/core": "^1.0.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
